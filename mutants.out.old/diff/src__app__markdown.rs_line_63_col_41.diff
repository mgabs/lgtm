     pub fn scroll_down(&mut self, amount: usize, viewport_height: usize) {
         self.scroll_offset = self
             .scroll_offset
             .saturating_add(amount)
             .min(self.max_scroll(viewport_height))
             .min(self.rendered_rows.len().saturating_sub(1));
